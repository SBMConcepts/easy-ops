{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM"],
        "module": "ESNext",
        "moduleDetection": "force",
        "moduleResolution": "bundler",
        "strict": true,
        "types": ["deno"],
        "noEmit": true,
        "allowImportingTsExtensions": true
    }
}
