# ── Auth0 ─────────────────────────────────────────────────────────────────────
# Your Auth0 tenant domain (e.g. dev-abc123.us.auth0.com)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com

# The Client ID of your Auth0 Single Page Application
VITE_AUTH0_CLIENT_ID=your_client_id

# The identifier of the API you registered in Auth0 (used as the audience)
# This ensures the access token is a JWT (not an opaque token) so Supabase
# can validate it.
VITE_AUTH0_AUDIENCE=https://api.easyops.app

# ── Supabase ───────────────────────────────────────────────────────────────────
# Your Supabase project URL and anon public key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
