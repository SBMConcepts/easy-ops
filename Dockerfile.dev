# Development Dockerfile with hot-reload support
FROM node:26

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Vite (5173) and Express API (3000)
EXPOSE 5173 3000

# Vite must bind 0.0.0.0 to be reachable from the host
CMD ["npx", "concurrently", "vite --host 0.0.0.0", "npm run server:dev"]
